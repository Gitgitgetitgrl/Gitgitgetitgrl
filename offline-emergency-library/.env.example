# Copy to .env and adjust.  ./scripts/03-start.sh reads this file.
# ---------------------------------------------------------------------------
# Defaults below are tuned for TIER 3 (gaming laptop / discrete GPU).
# For a GPU, also enable the `deploy:` block in docker-compose.yml (ollama)
# and install nvidia-container-toolkit on the host (00-install-host.sh helps).
# ---------------------------------------------------------------------------

# Rom's language model (pulled via Ollama on first start).
#   Tier 3 (GPU 12-16GB VRAM): qwen2.5:14b   (default) or llama3.1:70b (needs offload)
#   Tier 2 (mini-PC, 32GB):    llama3.1:8b
#   Tier 1 (Raspberry Pi):     phi3:mini  or  gemma2:2b
ROM_MODEL=qwen2.5:14b

# Embedding model for retrieval (small, runs anywhere).
EMBED_MODEL=nomic-embed-text

# How many source chunks Rom retrieves per question.
TOP_K=6

# Host ports (change only if they clash with something else).
ROM_PORT=8080
KIWIX_PORT=8090
OLLAMA_PORT=11434
QDRANT_PORT=6333
